# AI — Hack Club AI is the only provider (OpenRouter is retired).
# One key powers the study coach, editor help, simulator help, sessions, the
# notes/PDF → course pipeline and calendar parsing. Server-side only.
HACKCLUBAI_KEY=
HACKCLUBAI_MODEL=google/gemma-4-26b-a4b-it:free
# Optional extras
HACKCLUBAI_FALLBACK_MODELS=
HACKCLUBAI_JSON_MODEL=
# Session AI budgets (ms). The page plays the template immediately, so these can
# be generous; a late model reply upgrades the explanation.
SESSION_AI_BUDGET_MS=18000
SESSION_SUMMARY_BUDGET_MS=9000

# PostgreSQL (Aiven) - replaces the old MySQL connection
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PG_DATABASE=defaultdb
# Optional CA cert (falls back to DB_SSL_CA). TLS is always used.
PGSSL_CA=
# Shared connection pool. Aiven allows 20 total with 3 reserved for superusers,
# so 15 leaves headroom for psql/console sessions. instances x PG_POOL_MAX <= 17.
PG_POOL_MAX=15
PG_POOL_IDLE_MS=30000
PG_POOL_CONNECT_MS=15000

# Optional rate-limit overrides (defaults: auth 5 per 15 min, writes 100 per 15 min).
# Useful for local smoke tests / load tests only - leave unset in production.
AUTH_RATE_MAX=
WRITE_RATE_MAX=
