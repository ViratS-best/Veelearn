# OpenRouter (study coach / AI Help) — comma-separated keys for failover, or use OPENROUTER_KEY_1, OPENROUTER_KEY_2, ...
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional extras (built-in fallbacks always include gemma-4 + openrouter/free)
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free
# Optional headers OpenRouter uses for attribution
OPENROUTER_SITE_URL=https://veelearn.org
OPENROUTER_APP_TITLE=Veelearn Study Coach

# Hack Club AI (notes → master course). Server-side only — never expose to the frontend.
HACKCLUBAI_KEY=
HACKCLUBAI_MODEL=dots-studio/dots-3-note-preview:free
# Optional. Defaults to HACKCLUBAI_MODEL (dots-3-note-preview). Only set this to force a different JSON converter.
HACKCLUBAI_JSON_MODEL=

# PostgreSQL (Aiven) - replaces the old MySQL connection
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PG_DATABASE=defaultdb
# Optional CA cert (falls back to DB_SSL_CA). TLS is always used.
PGSSL_CA=
# Shared connection pool. Aiven allows 20 total with 3 reserved for superusers,
# so 15 leaves headroom for psql/console sessions. instances x PG_POOL_MAX <= 17.
PG_POOL_MAX=15
PG_POOL_IDLE_MS=30000
PG_POOL_CONNECT_MS=15000

# Optional rate-limit overrides (defaults: auth 5 per 15 min, writes 100 per 15 min).
# Useful for local smoke tests / load tests only - leave unset in production.
AUTH_RATE_MAX=
WRITE_RATE_MAX=
