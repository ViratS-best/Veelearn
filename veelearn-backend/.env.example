# OpenRouter (study coach / AI Help) — comma-separated keys for failover, or use OPENROUTER_KEY_1, OPENROUTER_KEY_2, ...
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional extras (built-in fallbacks always include gemma-4 + openrouter/free)
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free
# Optional headers OpenRouter uses for attribution
OPENROUTER_SITE_URL=https://veelearn.org
OPENROUTER_APP_TITLE=Veelearn Study Coach
