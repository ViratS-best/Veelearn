# OpenRouter (study coach) — comma-separated keys for failover, or use OPENROUTER_KEY_1, OPENROUTER_KEY_2, ...
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=z-ai/glm-4.5-air:free
# Comma-separated models to try after the primary when keys are rate-limited
OPENROUTER_FALLBACK_MODELS=google/gemma-3-27b-it:free,meta-llama/llama-3.3-70b-instruct:free
# Optional headers OpenRouter uses for attribution
OPENROUTER_SITE_URL=https://veelearn.org
OPENROUTER_APP_TITLE=Veelearn Study Coach
